{
  "db_name": "PostgreSQL",
  "query": "\n            UPDATE daily_tasks dpt\n            SET is_done = NOT dpt.is_done\n            FROM daily_progress dp\n            WHERE dpt.id = $1\n            AND dpt.daily_progress_id = dp.id\n            AND dp.user_id = $2\n            RETURNING dpt.id, dpt.task_id, dpt.daily_progress_id, dpt.is_done, dpt.created_at\n            ",
